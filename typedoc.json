{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./src/services/strict-store.service.ts",
    "./src/domain/entities/core/persistable.entity.ts",
    "./src/domain/entities/core/persistence-type.entity.ts",
    "./src/domain/entities/store-key/store-key.entity.ts",
    "./src/domain/entities/store-key/store-key.factory.ts",
    "./src/domain/entities/errors/strict-store.error.code.ts",
  ],
  "tsconfig": "./tsconfig.json",
  "out": "docs",
  "outputFileStrategy": "modules",
  "plugin": ["typedoc-plugin-markdown", "typedoc-github-wiki-theme"],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "includeVersion": true,
  "parametersFormat": "table",
  "readme": "./README.md"
}
