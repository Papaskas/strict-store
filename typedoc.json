{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./src/application/strict-store.service.ts",
    "./src/core/persistable/persistable.ts",
    "./src/core/store-key/persistence-type.ts",
    "./src/core/store-key/store-key.ts",
  ],
  "tsconfig": "./tsconfig.json",
  "out": "docs",
  "outputFileStrategy": "modules",
  "plugin": ["typedoc-plugin-markdown", "typedoc-github-wiki-theme"],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "includeVersion": true,
  "parametersFormat": "table",
  "readme": "./README.md"
}
