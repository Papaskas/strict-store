{
  "compilerOptions": {
    "lib": ["es2020", "DOM"],
    "target": "es2020",
    "module": "commonjs",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",

    "paths": {
      "strict-store": ["./src/index.module.ts"],
      "@test/*": ["./test/*"],
      "@src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test", "dist", "node_modules"]
}
